{
  "name": "@lambada-llc/codemirror-lang-lambada",
  "version": "0.0.0",
  "description": "CodeMirror 6 editing support for LambAda",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:demo",
    "build:demo": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "dev": "vite",
    "generate": "node scripts/generate.mjs",
    "prebuild:demo": "npm run generate",
    "prebuild:lib": "npm run generate",
    "predev": "npm run generate",
    "pretest": "npm run generate",
    "pretypecheck": "npm run generate",
    "test": "esbuild test/previews.test.ts --bundle --platform=node --format=esm --outfile=test/.build/previews.test.mjs && node --test test/.build/previews.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.0.0",
    "@lezer/lr": "^1.0.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.0.0",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.0.0",
    "@codemirror/lint": "^6.0.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@lezer/generator": "^1.8.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "cm6-theme-basic-dark": "^0.2.0",
    "cm6-theme-basic-light": "^0.2.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
